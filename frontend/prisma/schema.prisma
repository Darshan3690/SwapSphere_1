datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id        String   @id @map("_id") // Maps to Clerk's user ID string
  username  String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items          Item[]
  sentSwaps      SwapRequest[]   @relation("SenderSwaps")
  receivedSwaps  SwapRequest[]   @relation("ReceiverSwaps")
  messages       Message[]
  escrowDeposits EscrowDeposit[]

  referralCode   String?         @map("referral_code") // Removed unique to avoid duplicate null indexes in Mongo
  referredBy     String?         @map("referred_by")
  freeBoosts     Int             @default(0) @map("free_boosts")
  creditBalance  Float           @default(0.0) @map("credit_balance")
  role           String          @default("USER")

  isBanned       Boolean         @default(false) @map("is_banned")
  isSuspended    Boolean         @default(false) @map("is_suspended")
  trustScore     Int             @default(100) @map("trust_score")
  isVerified     Boolean         @default(false) @map("is_verified")

  reviewsGiven    Review[]       @relation("Reviewer")
  reviewsReceived Review[]       @relation("Reviewee")
  notifications   Notification[]
  referralsMade   Referral[]     @relation("Referrer")
  referralReceived Referral[]    @relation("Referee")

  @@map("profiles")
}

model Item {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @map("user_id")
  user           Profile   @relation(fields: [userId], references: [id])
  title          String
  description    String
  category       String
  condition      String
  imageUrl       String?   @map("image_url")
  preferredTrade String?   @map("preferred_trade")
  
  // Coupon specific fields
  couponCode     String?   @map("coupon_code")
  couponExpiry   DateTime? @map("coupon_expiry")
  isCoupon       Boolean   @default(false) @map("is_coupon")
  price          Int?      @map("price")
  status         String    @default("Available") // Available, Pending, Swapped

  isFeatured          Boolean   @default(false) @map("is_featured")
  isSuspicious        Boolean   @default(false) @map("is_suspicious")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  verificationStatus  String    @default("Approved") @map("verification_status") // Approved, Pending, Rejected

  
  createdAt      DateTime  @default(now()) @map("created_at")

  senderSwaps    SwapRequest[]   @relation("SenderItem")
  receiverSwaps  SwapRequest[]   @relation("ReceiverItem")
  escrowDeposits EscrowDeposit[]

  listingType    String    @default("SWAP_ONLY") @map("listing_type") // SWAP_ONLY, SELL_ONLY, SWAP_AND_SELL
  sellingPrice   Int?      @map("selling_price")
  brand          String?
  voucherValue   Int?      @map("voucher_value")
  categoryId     String?   @db.ObjectId @map("category_id")
  categoryRel    Category? @relation(fields: [categoryId], references: [id])
  boostedUntil   DateTime? @map("boosted_until")

  @@map("items")
}

model SwapRequest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId       String   @map("sender_id")
  sender         Profile  @relation("SenderSwaps", fields: [senderId], references: [id])
  receiverId     String   @map("receiver_id")
  receiver       Profile  @relation("ReceiverSwaps", fields: [receiverId], references: [id])
  
  senderItemId   String?  @map("sender_item_id") @db.ObjectId
  senderItem     Item?    @relation("SenderItem", fields: [senderItemId], references: [id])
  receiverItemId String   @map("receiver_item_id") @db.ObjectId
  receiverItem   Item     @relation("ReceiverItem", fields: [receiverItemId], references: [id])
  
  status         String   @default("Pending") // Pending, Accepted, Rejected, Completed, Cancelled
  createdAt      DateTime @default(now()) @map("created_at")

  messages       Message[]
  escrowDeposits EscrowDeposit[]

  @@map("swap_requests")
}

model Message {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  swapRequestId String      @map("swap_request_id") @db.ObjectId
  swapRequest   SwapRequest @relation(fields: [swapRequestId], references: [id])
  senderId      String      @map("sender_id")
  sender         Profile     @relation(fields: [senderId], references: [id])
  content       String
  createdAt     DateTime    @default(now()) @map("created_at")

  isReported    Boolean     @default(false) @map("is_reported")

  @@map("messages")
}

model EscrowDeposit {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  swapRequestId      String      @map("swap_request_id") @db.ObjectId
  swapRequest        SwapRequest @relation(fields: [swapRequestId], references: [id])
  depositorId        String      @map("depositor_id")
  depositor          Profile     @relation(fields: [depositorId], references: [id])
  itemId             String      @map("item_id") @db.ObjectId
  item               Item        @relation(fields: [itemId], references: [id])
  
  couponCode         String      @map("coupon_code")
  couponExpiry       DateTime?   @map("coupon_expiry")
  verificationStatus String      @default("pending") @map("verification_status") // pending, verified, invalid
  depositedAt        DateTime    @default(now()) @map("deposited_at")

  @@unique([swapRequestId, depositorId])
  @@map("escrow_deposits")
}

model Category {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String @unique
  items Item[]

  @@map("categories")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int      // 1 to 5 stars
  comment    String?
  reviewerId String   @map("reviewer_id")
  reviewer   Profile  @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String   @map("reviewee_id")
  reviewee   Profile  @relation("Reviewee", fields: [revieweeId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  user      Profile  @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Referral {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  referrerId  String   @map("referrer_id")
  referrer    Profile  @relation("Referrer", fields: [referrerId], references: [id])
  refereeId   String   @map("referee_id")
  referee     Profile  @relation("Referee", fields: [refereeId], references: [id])
  status      String   @default("PENDING") // PENDING, COMPLETED
  rewardType  String   @map("reward_type") // FREE_BOOST, COMMISSION_DISCOUNT, CREDIT
  rewardValue Float    @map("reward_value")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("referrals")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Announcement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  isActive  Boolean  @default(true) @map("is_active")

  @@map("announcements")
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String
  subject   String
  message   String
  status    String   @default("Open") // Open, Resolved, Archived
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  logoUrl   String?  @map("logo_url")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brands")
}
